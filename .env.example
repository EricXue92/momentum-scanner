# Copy to .env and fill in. .env is gitignored.
# Used by scripts/run_eod.sh and scripts/run_hk_eod.sh to give the launchd-
# triggered `--mode report` step access to the report-backend API keys.
# Only fill in what the chosen [report] backend needs (see config.toml):
#   anthropic  -> ANTHROPIC_API_KEY
#   deepseek   -> DEEPSEEK_API_KEY + TAVILY_API_KEY  (shipped default)
#   kimi       -> MOONSHOT_API_KEY + TAVILY_API_KEY
#   glm        -> ZHIPUAI_API_KEY  + TAVILY_API_KEY
#   minimax    -> MINIMAX_API_KEY  + TAVILY_API_KEY
# The pre-market catalyst report always uses DeepSeek + Tavily.

# ntfy.sh topic for every pipeline alert (python + shell). Keep it out of
# git: the repo is public and the topic name is the only secret ntfy has.
NTFY_TOPIC=some-long-random-string

ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
TAVILY_API_KEY=tvly-...
# MOONSHOT_API_KEY=sk-...
# ZHIPUAI_API_KEY=...
# MINIMAX_API_KEY=...
