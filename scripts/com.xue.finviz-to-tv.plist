<?xml version="1.0" encoding="UTF-8"?>
<!--
  US EOD slot: Tue-Sat 12:00 HKT (after US close in both EDT/EST and after
  the upstream RS Rating commit). Runs scripts/run_eod.sh which rotates and
  owns the log (output/launchd_US.log) itself — deliberately NO
  StandardOutPath/StandardErrorPath here: launchd would hold an append-mode
  fd open through the wrapper's in-process truncate, leaving a NUL-padded
  hole at the start of each new day's log.

  Requires a pmset wake so the Mac is awake at the slot:
    sudo pmset repeat wakeorpoweron TWRFS 11:59:00
  (keyword is `wakeorpoweron` on macOS 26+; the old `wakepoweron` no longer
  parses.)

  Install:
    cp scripts/com.xue.finviz-to-tv.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) \
        ~/Library/LaunchAgents/com.xue.finviz-to-tv.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xue.finviz-to-tv</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/xue/momentum-scanner/scripts/run_eod.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <!-- Tue-Sat 12:00 HKT (Weekday: 0=Sun .. 6=Sat) -->
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>WorkingDirectory</key>
    <string>/Users/xue/momentum-scanner</string>
</dict>
</plist>
